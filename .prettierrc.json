{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "singleQuote": false
      }
    },
    {
      "files": "apps/web/**",
      "options": {
        "tailwindStylesheet": "./apps/web/src/index.css"
      }
    },
    {
      "files": "apps/site/**",
      "options": {
        "tailwindStylesheet": "./apps/site/src/styles/global.css"
      }
    },
    {
      "files": "packages/ui/**",
      "options": {
        "tailwindStylesheet": "./apps/web/src/index.css"
      }
    }
  ]
}
