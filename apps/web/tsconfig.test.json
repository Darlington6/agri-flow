{
  // Type-checks the test files, which (unlike app code) may use Node APIs
  // such as process.env. App code is checked by tsconfig.app.json, which
  // excludes tests so it can't accidentally depend on Node.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"],
  "exclude": []
}
