# Where the API is. Locally, the docker compose API. On Vercel, set it per
# environment (Production and Preview); see .github/CONTRIBUTING.md (Deployments).
VITE_API_URL=http://localhost:8000

# Error reports (Sentry project agriflow-web). Leave unset locally; set it on
# Vercel for Production and Preview.
# VITE_SENTRY_DSN=

# The public site, for the terms and privacy links. Optional: defaults to the
# production site.
# VITE_SITE_URL=https://agri-flow-site.vercel.app
