---
// The home page is one long scroll with a section for every menu item; the
// header menu jumps to them (see lib/sections.ts). Each section links on to
// its own page, which keeps the detail and ranks on its own in search.
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroSlideshow from '../components/HeroSlideshow.astro'
import Photo from '../components/Photo.astro'
import SplitSection from '../components/SplitSection.astro'
import AppStoreBadges from '../components/AppStoreBadges.astro'
import LogoGlow from '../components/LogoGlow.astro'
import FieldRows from '../components/FieldRows.astro'
import CtaBand from '../components/CtaBand.astro'
import { dictionaryFor, LOCALES, localizedPath, PUBLISHED_LOCALES, type Locale } from '../i18n'
import { organizationLd, websiteLd } from '../lib/seo'
import { SECTIONS } from '../lib/sections'
import { createAccountUrl, signInUrl } from '../lib/app'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = dictionaryFor(locale)
const site = Astro.site ?? new URL('http://localhost:4321')
const createAccount = createAccountUrl()
const signIn = signInUrl()
---

<BaseLayout
  locale={locale}
  page="home"
  title={t.home.title}
  description={t.home.description}
  structuredData={[
    organizationLd(site, t.meta.siteName, t.meta.defaultDescription),
    websiteLd(site, t.meta.siteName, PUBLISHED_LOCALES.map((l) => LOCALES[l].code)),
  ]}
>
  <!-- Hero: photo slideshow background, dark wash for legible text -->
  <section class="relative isolate overflow-hidden bg-brand-950 text-cream">
    <div class="absolute inset-0 -z-20">
      <HeroSlideshow artLabel={t.home.hero.artLabel} />
    </div>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-b from-brand-950/80 via-brand-950/70 to-brand-950/90 md:bg-gradient-to-r md:from-brand-950/90 md:via-brand-950/65 md:to-brand-950/25"></div>
    <div class="mx-auto max-w-6xl px-4 pb-24 pt-16 sm:px-6 sm:pb-32 sm:pt-24 md:pb-40 md:pt-28">
      <p class="mb-5 text-sm font-semibold uppercase tracking-[0.16em] text-gold-300">{t.home.hero.eyebrow}</p>
      <h1 class="max-w-3xl text-[2.6rem] font-semibold leading-[1.04] tracking-tight text-cream sm:text-6xl md:text-7xl">
        {t.home.hero.title}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-sage-100 sm:text-xl">{t.home.hero.lede}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={localizedPath(locale, 'requestDemo')}
          class="inline-flex min-h-12 items-center justify-center rounded-full bg-gold-400 px-7 text-base font-semibold text-brand-950 hover:bg-gold-300"
        >
          {t.cta.requestDemo}
        </a>
        <a
          href={`#${SECTIONS.howItWorks}`}
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-cream/40 px-7 text-base font-semibold text-cream hover:bg-white/10"
        >
          {t.cta.seeHowItWorks}
        </a>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="mx-auto grid max-w-6xl gap-6 px-4 py-20 sm:px-6 md:grid-cols-[1.1fr_1fr] md:gap-16 md:py-28">
    <h2 class="text-3xl font-semibold leading-tight sm:text-4xl">{t.home.problem.title}</h2>
    <p class="text-lg leading-relaxed text-ink-700">{t.home.problem.body}</p>
  </section>

  <!-- How it works -->
  <section id={SECTIONS.howItWorks} class="scroll-mt-20 bg-cream" aria-labelledby="how-title">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-24">
      <h2 id="how-title" class="text-3xl font-semibold sm:text-4xl">{t.home.loop.title}</h2>
      <p class="mt-3 max-w-2xl text-lg text-ink-700">{t.home.loop.lede}</p>
      <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          t.home.loop.steps.map((step, i) => (
            <li class="relative rounded-3xl bg-white p-6 shadow-[0_1px_2px_rgba(16,21,16,0.04),0_12px_32px_-18px_rgba(16,21,16,0.25)]">
              <span class="font-display text-5xl font-semibold leading-none text-gold-400" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 text-xl font-semibold">{step.title}</h3>
              <p class="mt-2 text-ink-700">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <a href={localizedPath(locale, 'howItWorks')} class="mt-10 inline-flex min-h-11 items-center gap-2 font-semibold text-primary-700 hover:text-primary-800 hover:underline">
        {t.home.audiences.more}
        <span class="sr-only">: {t.howItWorks.title}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- Audiences -->
  <SplitSection
    id={SECTIONS.buyers}
    title={t.buyers.title}
    lede={t.buyers.lede}
    points={t.buyers.points}
    photo={{ slot: 'buyers', alt: t.media.buyers }}
    detail={{ slot: 'buyersDetail', alt: t.media.buyersDetail }}
    learnMore={{ href: localizedPath(locale, 'buyers'), label: t.home.audiences.more }}
  />
  <SplitSection
    id={SECTIONS.farmers}
    title={t.farmers.title}
    lede={t.farmers.lede}
    points={t.farmers.points}
    photo={{ slot: 'farmers', alt: t.media.farmers }}
    detail={{ slot: 'farmersDetail', alt: t.media.farmersDetail }}
    learnMore={{ href: localizedPath(locale, 'farmers'), label: t.home.audiences.more }}
    reverse
    tone="bg-sage-50"
  />
  <SplitSection
    id={SECTIONS.partners}
    title={t.partners.title}
    lede={t.partners.lede}
    points={[t.partners.agents, t.partners.transporters]}
    photo={{ slot: 'partners', alt: t.media.partners }}
    detail={{ slot: 'partnersDetail', alt: t.media.partnersDetail }}
    learnMore={{ href: localizedPath(locale, 'partners'), label: t.home.audiences.more }}
  />

  <!-- Climate: full-bleed photo with a dark wash -->
  <section class="relative isolate overflow-hidden bg-brand-950">
    <div class="absolute inset-0 -z-20">
      <Photo slot="climate" alt="" sizes="100vw" background />
    </div>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-t from-brand-950/95 via-brand-950/70 to-brand-950/30 md:bg-gradient-to-r md:from-brand-950/90 md:via-brand-950/55 md:to-transparent"></div>
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 md:py-32">
      <div class="max-w-xl">
        <h2 class="text-3xl font-semibold text-cream sm:text-4xl">{t.home.climate.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-sage-100">{t.home.climate.body}</p>
      </div>
    </div>
  </section>

  <!-- The app: stores (coming soon) and the web app (today) -->
  <section id={SECTIONS.app} class="relative isolate scroll-mt-20 overflow-hidden bg-brand-900 text-cream" aria-labelledby="app-title">
    <FieldRows id="app" class="h-[45%] opacity-50" />
    <LogoGlow class="-bottom-56 -left-48 h-[26rem] w-[26rem] opacity-70 sm:-bottom-64 sm:-left-40 sm:h-[32rem] sm:w-[32rem]" />
    <div class="relative mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-2 md:py-24">
      <div>
        <h2 id="app-title" class="text-3xl font-semibold text-cream sm:text-4xl">{t.apps.title}</h2>
        <p class="mt-3 max-w-md text-lg text-sage-100">{t.apps.body}</p>
        <div class="mt-7">
          <AppStoreBadges locale={locale} tone="dark" />
        </div>
      </div>
      {
        createAccount && signIn && (
          <div class="self-start rounded-3xl border border-white/10 bg-brand-950 p-7">
            <h3 class="text-2xl font-semibold text-cream">{t.apps.webTitle}</h3>
            <p class="mt-2 text-sage-100">{t.apps.webBody}</p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <a
                href={createAccount}
                data-app-link="create-account"
                class="inline-flex min-h-12 items-center justify-center rounded-full bg-gold-400 px-7 font-semibold text-brand-950 hover:bg-gold-300"
              >
                {t.cta.createAccount}
              </a>
              <a
                href={signIn}
                data-app-link="log-in"
                class="inline-flex min-h-12 items-center justify-center rounded-full border border-cream/40 px-7 font-semibold text-cream hover:bg-white/10"
              >
                {t.cta.logIn}
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- About -->
  <section id={SECTIONS.about} class="scroll-mt-20" aria-labelledby="about-title">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-24">
      <h2 id="about-title" class="text-3xl font-semibold sm:text-4xl">{t.about.title}</h2>
      <p class="mt-3 max-w-2xl text-lg text-ink-700">{t.about.lede}</p>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {
          t.about.sections.map((s) => (
            <div>
              <h3 class="text-xl font-semibold">{s.title}</h3>
              <p class="mt-2 text-ink-700">{s.body}</p>
            </div>
          ))
        }
      </div>
      <a href={localizedPath(locale, 'about')} class="mt-10 inline-flex min-h-11 items-center gap-2 font-semibold text-primary-700 hover:text-primary-800 hover:underline">
        {t.home.audiences.more}
        <span class="sr-only">: {t.about.title}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <CtaBand locale={locale} title={t.home.finalCta.title} body={t.home.finalCta.body} />
</BaseLayout>
