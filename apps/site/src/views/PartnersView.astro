---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import CtaBand from '../components/CtaBand.astro'
import AppStoreBadges from '../components/AppStoreBadges.astro'
import { dictionaryFor, type Locale } from '../i18n'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = dictionaryFor(locale)
const groups = [
  { ...t.partners.agents, tone: 'bg-sage-100' },
  { ...t.partners.transporters, tone: 'bg-primary-50' },
]
---

<BaseLayout locale={locale} page="partners" title={t.partners.title} description={t.partners.description}>
  <PageHero title={t.partners.title} lede={t.partners.lede} photo="pagePartners" />
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <ul class="grid gap-5 md:grid-cols-2">
      {
        groups.map((g) => (
          <li class={`rounded-3xl p-8 ${g.tone}`}>
            <h2 class="text-3xl font-semibold">{g.title}</h2>
            <p class="mt-3 text-lg leading-relaxed text-ink-700">{g.body}</p>
          </li>
        ))
      }
    </ul>
    <div class="mt-14 flex flex-col gap-5 rounded-3xl border border-ink-100 p-8 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <h2 class="text-2xl font-semibold">{t.apps.title}</h2>
        <p class="mt-2 text-ink-700">{t.apps.body}</p>
      </div>
      <AppStoreBadges locale={locale} tone="light" />
    </div>
  </section>
  <CtaBand locale={locale} title={t.home.finalCta.title} body={t.home.finalCta.body} />
</BaseLayout>
