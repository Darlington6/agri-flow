---
// Closing call to action on every page: the illuminated logo over field rows.
// On laptops and desktops the button sits in the centre of the gold sun; on
// smaller screens it sits under the text, with the logo off to the right.
import LogoGlow from './LogoGlow.astro'
import FieldRows from './FieldRows.astro'
import { dictionaryFor, localizedPath, type Locale } from '../i18n'

interface Props {
  locale: Locale
  title: string
  body: string
}
const { locale, title, body } = Astro.props
const t = dictionaryFor(locale)
---

<section class="relative isolate overflow-hidden bg-brand-800">
  <FieldRows id="cta" class="h-[55%] opacity-60" />
  <LogoGlow class="-right-40 top-1/2 h-[26rem] w-[26rem] -translate-y-1/2 opacity-60 lg:hidden" />
  <div class="relative mx-auto flex max-w-6xl flex-col gap-6 px-4 py-14 sm:px-6 lg:min-h-[24rem] lg:flex-row lg:items-center lg:justify-between lg:py-10">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold text-cream sm:text-4xl">{title}</h2>
      <p class="mt-3 text-lg text-sage-100">{body}</p>
    </div>
    <div class="relative flex shrink-0 items-center justify-center lg:h-60 lg:w-72">
      <LogoGlow class="left-1/2 top-1/2 hidden h-[44rem] w-[44rem] -translate-x-1/2 -translate-y-1/2 opacity-50 lg:block" />
      <a
        href={localizedPath(locale, 'requestDemo')}
        class="relative inline-flex min-h-12 w-full items-center justify-center rounded-full border border-cream/40 px-7 text-base font-semibold text-cream hover:bg-white/10 sm:w-auto"
      >
        {t.cta.requestDemo}
      </a>
    </div>
  </div>
</section>
