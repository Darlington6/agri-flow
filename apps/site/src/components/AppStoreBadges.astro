---
// Placeholders for the future mobile apps. Deliberately not the official
// Apple / Google badges or logos: those trademarks may only be used once an
// app is actually listed. At launch, swap these for the official badges and
// link them to the store listings.
import { dictionaryFor, type Locale } from '../i18n'

interface Props {
  locale: Locale
  tone?: 'light' | 'dark'
}
const { locale, tone = 'dark' } = Astro.props
const t = dictionaryFor(locale)
const stores = [t.apps.appStore, t.apps.googlePlay]
const surface = tone === 'dark' ? 'border-white/25 bg-white/5 text-cream' : 'border-ink-200 bg-white text-ink-800'
---

<ul class="flex flex-wrap gap-3">
  {
    stores.map((name) => (
      <li>
        <span
          role="img"
          aria-label={`${name}: ${t.apps.notYetAvailable}`}
          class:list={['inline-flex min-h-14 min-w-44 items-center gap-3 rounded-2xl border px-4 py-2', surface]}
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <rect x="6.5" y="2.75" width="11" height="18.5" rx="2.5"></rect>
            <path d="M10.5 18h3"></path>
          </svg>
          <span class="grid leading-tight">
            <span class="text-[11px] font-medium uppercase tracking-wider opacity-80">{t.apps.comingSoon}</span>
            <span class="text-base font-semibold">{name}</span>
          </span>
        </span>
      </li>
    ))
  }
</ul>
