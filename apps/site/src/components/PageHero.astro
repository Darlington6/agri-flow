---
// Title band used at the top of every page except home. With `photo`, it's a
// dark band over a background photo (the pages behind "Learn more", request a
// demo); without, a light band (privacy, terms), where a photo would only
// distract from the text.
import Photo from './Photo.astro'
import type { PhotoSlot } from '../media/manifest'

interface Props {
  title: string
  lede: string
  eyebrow?: string
  photo?: PhotoSlot
}
const { title, lede, eyebrow, photo } = Astro.props
---

{photo ? (
  <section class="relative isolate overflow-hidden bg-brand-950 text-cream" data-photo-header>
    <div class="page-hero-photo absolute inset-0 -z-20">
      <Photo slot={photo} alt="" sizes="100vw" priority background />
    </div>
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 bg-gradient-to-b from-brand-950/85 via-brand-950/75 to-brand-950/90 md:bg-gradient-to-r md:from-brand-950/90 md:via-brand-950/70 md:to-brand-950/30"
    />
    <div class="mx-auto max-w-6xl px-4 pb-16 pt-16 sm:px-6 sm:pb-20 sm:pt-24 md:pb-24">
      {eyebrow && <p class="mb-4 text-sm font-semibold uppercase tracking-[0.14em] text-gold-300">{eyebrow}</p>}
      <h1 class="max-w-3xl text-4xl font-semibold leading-[1.08] tracking-tight text-cream sm:text-5xl md:text-6xl">
        {title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-sage-100 sm:text-xl">{lede}</p>
    </div>
  </section>
) : (
  <section class="relative overflow-hidden bg-cream">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-gold-200/60 blur-3xl"
    />
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-sage-200/70 blur-3xl"
    />
    <div class="relative mx-auto max-w-6xl px-4 pb-14 pt-14 sm:px-6 sm:pt-20">
      {eyebrow && <p class="mb-4 text-sm font-semibold uppercase tracking-[0.14em] text-gold-700">{eyebrow}</p>}
      <h1 class="max-w-3xl text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl md:text-6xl">{title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-700 sm:text-xl">{lede}</p>
    </div>
  </section>
)}

<style>
  /* The header photo settles with one slow zoom as the page opens, then stays still. */
  .page-hero-photo :global(img) {
    animation: settle 12s cubic-bezier(0.2, 0.6, 0.2, 1) both;
  }
  @keyframes settle {
    from {
      transform: scale(1.08);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-hero-photo :global(img) {
      animation: none;
    }
  }
</style>
