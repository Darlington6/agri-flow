---
// Compact language picker: a button showing the current language code that
// opens a list of every published language, each named in its own language.
// Fits any screen width and any number of languages; works without
// JavaScript. Renders nothing while only one language is published.
import { dictionaryFor, LOCALES, localizedPath, PUBLISHED_LOCALES, type Locale, type PageKey } from '../i18n'

interface Props {
  locale: Locale
  current?: PageKey
}
const { locale, current = 'home' } = Astro.props
const t = dictionaryFor(locale)
---

{
  PUBLISHED_LOCALES.length > 1 && (
    <details class="group relative" data-language-switcher data-dismissable>
      <summary
        aria-label={`${t.a11y.language}: ${LOCALES[locale].nativeName}`}
        class="flex min-h-11 cursor-pointer list-none items-center gap-1.5 rounded-full border border-ink-200 px-3 text-sm font-semibold uppercase text-ink-800 hover:bg-ink-50 [&::-webkit-details-marker]:hidden"
      >
        <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="10" cy="10" r="7.5" />
          <path d="M2.5 10h15M10 2.5c2.2 2.3 2.2 12.7 0 15M10 2.5c-2.2 2.3-2.2 12.7 0 15" />
        </svg>
        {LOCALES[locale].code}
      </summary>
      <ul class="absolute right-0 top-[calc(100%+0.5rem)] z-50 min-w-48 rounded-2xl border border-ink-100 bg-white p-2 shadow-xl">
        {PUBLISHED_LOCALES.map((l) => (
          <li>
            <a
              href={localizedPath(l, current)}
              hreflang={LOCALES[l].code}
              lang={LOCALES[l].code}
              aria-current={l === locale ? 'true' : undefined}
              class="flex min-h-11 items-center justify-between gap-4 rounded-xl px-4 text-base text-ink-800 hover:bg-ink-50 aria-[current=true]:font-semibold aria-[current=true]:text-primary-700"
            >
              {LOCALES[l].nativeName}
              {l === locale && <span aria-hidden="true">✓</span>}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}
