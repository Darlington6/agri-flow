# Copy to .env for local (non-Docker) runs. docker-compose.yml sets these
# directly for the containerized dev environment — see the root
# docker-compose.yml and its own .env.example.
# Real values are never committed — see Platform Blueprint, Section 17.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-real-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://agriflow:agriflow@localhost:5432/agriflow
REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173
