# Copy to .env for local (non-Docker) runs. docker-compose.yml sets these
# directly for the containerized dev environment — see the root
# docker-compose.yml and its own .env.example.
# Real values are never committed — see Platform Blueprint, Section 17.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-real-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://agriflow:agriflow@localhost:5433/agriflow
REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Staging and prod also need BREVO_API_KEY and DEFAULT_FROM_EMAIL, and
# refuse to start without them; locally, emails are printed to the console.
# This file is never read with those settings. See .github/CONTRIBUTING.md
# (Deployments).
